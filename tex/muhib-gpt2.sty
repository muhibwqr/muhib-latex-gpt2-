\def\gpt@bpe{\gpt@loop{\gpt@pl}{\gpt@byteid{\gpt@PB\gpt@i}\gpt@PB\gpt@i=\gpt@t}\gpt@merge
  \gpt@loop{\gpt@pl}{\expandafter\edef\csname gpt@seq\the\gpt@np\endcsname{\the\gpt@PB\gpt@i}\advance\gpt@np\@ne}}
\def\gpt@merge{\gpt@br=2147483647
