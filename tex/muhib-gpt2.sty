% ---- causal self-attention with a KV cache kept in macros ----
% K cache entry: an expression "0+k1*\!Qab+..." evaluated against the current q.
% V cache entry: "\!v{v1}\!v{v2}..." which accumulates p*v into A.
\def\!v#1{\advance\gpt@oi\@ne\advance\count\gpt@oi\numexpr\gpt@p*#1/65536\relax}
\def\gpt@kname{gpt@K\the\gpt@layer.\the\gpt@tp.\the\gpt@h}
\def\gpt@vname{gpt@V\the\gpt@layer.\the\gpt@tp.\the\gpt@h}
\def\gpt@tploop#1{\gpt@tp=0 \def\gpt@tpbody{#1}\gpt@tpiter}
\def\gpt@tpiter{\ifnum\gpt@tp>\gpt@pos\else\gpt@tpbody\advance\gpt@tp\@ne\expandafter\gpt@tpiter\fi}
\def\gpt@attn{\gpt@loop{768}{\gpt@A\gpt@i=0 }\gpt@h=0 \gpt@heads}
\def\gpt@heads{\ifnum\gpt@h<12 \gpt@head\advance\gpt@h\@ne\expandafter\gpt@heads\fi}
\def\gpt@head{%
