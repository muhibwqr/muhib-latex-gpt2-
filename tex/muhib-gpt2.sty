\def\gpt@word#1{\gpt@nc=0 \gpt@wc#1\gpt@stop \gpt@ci=0 \gpt@pieces}
\def\gpt@wc#1{\ifx\gpt@stop#1\else\gpt@WC\gpt@nc=\number`#1\relax\advance\gpt@nc\@ne\expandafter\gpt@wc\fi}
\def\gpt@push#1{\gpt@PB\gpt@pl=#1\relax\advance\gpt@pl\@ne}
\def\gpt@pieces{\ifnum\gpt@ci<\gpt@nc \gpt@onepiece\expandafter\gpt@pieces\fi}
\def\gpt@onepiece{\gpt@pl=0 \gpt@contra=0
