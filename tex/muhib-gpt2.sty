% \muhib[n]{prompt}: tokenizes the prompt, runs GPT-2 for n greedy tokens, typesets prompt + continuation
\newcommand\muhib[2][8]{\edef\gpt@elc{\the\endlinechar}\begingroup\globaldefs=\@ne
  \gpt@loadtok\gpt@savebytes\gpt@encode{#2}\def\gpt@prompt@now{#2}\gpt@pos=0 \gpt@ngen=0
