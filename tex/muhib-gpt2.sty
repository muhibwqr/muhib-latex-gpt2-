\def\gpt@cand#1{\csname gpt@cpc\the\gpt@ngen.#1\endcsname\@percentchar}
\def\gpt@cand@id#1{\csname gpt@cid\the\gpt@ngen.#1\endcsname}
% candidate #2 = top-5 slot #1: id, probability in basis points, and as "41.2"
\def\gpt@rc#1#2{\gpt@expneg{\numexpr(\gpt@best-\csname gpt@tv#1\endcsname)*64\relax}%
