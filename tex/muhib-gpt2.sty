% ---- live mode state file: plain TeX assignments, read back with \@@input ----
\def\gpt@kv#1#2{\expandafter\gdef\csname#1\endcsname{#2}}
\def\gpt@loadstate{\openin\gpt@srd=\jobname.gpt\relax\ifeof\gpt@srd\else\closein\gpt@srd
