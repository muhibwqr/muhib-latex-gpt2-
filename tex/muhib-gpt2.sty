  \gpt@tp=\gpt@pos \expandafter\let\csname\gpt@kname\endcsname\gpt@tmp
  \def\gpt@tmp{}%
  \gpt@loop{64}{\edef\gpt@tmp{\gpt@tmp\noexpand\!v{\the\count\numexpr13536+64*\gpt@h+\gpt@i\relax}}}%
