\def\gpt@run@cls{\ifnum\gpt@ci<\gpt@nc \gpt@class{\gpt@WC\gpt@ci}%
  \ifnum\gpt@cl=\gpt@runcl\relax \gpt@push{\gpt@WC\gpt@ci}\advance\gpt@ci\@ne
  \expandafter\expandafter\expandafter\gpt@run@cls\fi\fi}
\def\gpt@trycontra{\ifnum\gpt@WC\gpt@ci=39 \ifnum\numexpr\gpt@ci+1\relax<\gpt@nc
